{
  "entities": {
    "User": {
      "title": "User",
      "description": "User accounts and resident profiles including household registration data and eco points",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "fullName": {
          "type": "string",
          "description": "Full name of the resident or official"
        },
        "role": {
          "type": "string",
          "description": "User role: RESIDENT, BARANGAY_OFFICIAL, CENRO_OFFICER, ENVIRO_CHAMPION, or SUPER_ADMIN"
        },
        "barangayId": {
          "type": "string",
          "description": "Identifier for the resident's home barangay"
        },
        "barangayName": {
          "type": "string",
          "description": "Name of the resident's home barangay"
        },
        "city": {
          "type": "string",
          "description": "City or municipality"
        },
        "province": {
          "type": "string",
          "description": "Province name"
        },
        "region": {
          "type": "string",
          "description": "Region name"
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number"
        },
        "avatarUrl": {
          "type": "string",
          "description": "Profile picture URL"
        },
        "ecoPoints": {
          "type": "number",
          "description": "Total eco reward points accumulated"
        },
        "ecoScore": {
          "type": "number",
          "description": "Barangay eco compliance score"
        },
        "kgRecycled": {
          "type": "number",
          "description": "Total kilograms of recyclable waste submitted"
        },
        "householdRegistered": {
          "type": "boolean",
          "description": "Whether the resident has registered their household"
        },
        "householdHeadName": {
          "type": "string",
          "description": "Name of the head of the household"
        },
        "householdMembersCount": {
          "type": "number",
          "description": "Number of residents in the household"
        },
        "householdAddress": {
          "type": "string",
          "description": "Physical residential address within the barangay"
        },
        "householdSegregationType": {
          "type": "string",
          "description": "Segregation scheme practiced by household"
        },
        "verifiedOfficial": {
          "type": "boolean",
          "description": "Whether the user is a verified LGU official"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account registration timestamp"
        }
      },
      "required": [
        "email",
        "fullName",
        "role",
        "barangayId"
      ]
    },
    "Barangay": {
      "title": "Barangay",
      "description": "Barangay sustainability profile and metrics",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Barangay ID"
        },
        "name": {
          "type": "string",
          "description": "Barangay name"
        },
        "cityName": {
          "type": "string",
          "description": "City or municipality"
        },
        "provinceName": {
          "type": "string",
          "description": "Province name"
        },
        "population": {
          "type": "number",
          "description": "Barangay population"
        }
      },
      "required": [
        "name",
        "cityName",
        "provinceName"
      ]
    },
    "EnvironmentalReport": {
      "title": "EnvironmentalReport",
      "description": "Citizen environmental issue report",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique report ID"
        },
        "reporterId": {
          "type": "string",
          "description": "User ID who reported"
        },
        "barangayId": {
          "type": "string",
          "description": "Barangay ID where issue occurred"
        },
        "category": {
          "type": "string",
          "description": "Category of violation or dumping"
        },
        "status": {
          "type": "string",
          "description": "Pending, In Progress, or Resolved"
        }
      },
      "required": [
        "reporterId",
        "barangayId",
        "category",
        "status"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of registered user accounts and household profiles"
    },
    "/barangays/{barangayId}": {
      "schema": "Barangay",
      "description": "Barangay sustainability and ranking data"
    },
    "/reports/{reportId}": {
      "schema": "EnvironmentalReport",
      "description": "Environmental reports submitted by citizens"
    }
  }
}

